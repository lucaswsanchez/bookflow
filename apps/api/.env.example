# PostgreSQL connection used by the app at runtime.
# Supabase: "Transaction pooler" URL (port 6543) + ?pgbouncer=true
DATABASE_URL="postgresql://bookflow:bookflow@localhost:5432/bookflow"
# Direct/session connection used by Prisma migrations and the seed.
# Supabase: "Session pooler" URL (port 5432)
DIRECT_URL="postgresql://bookflow:bookflow@localhost:5432/bookflow"

# Secret used to sign access tokens (use a long random string in production)
JWT_ACCESS_SECRET="change-me"
# Access token lifetime in seconds (default 900 = 15 min)
JWT_ACCESS_TTL=900
# Refresh token lifetime in days (default 7)
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:5173"
# Max login attempts per IP per minute
LOGIN_RATE_LIMIT=10
PORT=3000
